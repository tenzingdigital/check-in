# ============================================================================
#  Hut Check-In — environment configuration (EXAMPLE)
# ----------------------------------------------------------------------------
#  Copy this file to ".env" and fill in values for LOCAL development:
#      cp .env.example .env
#  The app loads ".env" automatically when you run "npm start".
#  NEVER commit your real ".env" — it is gitignored and holds the connection
#  string, which is the whole database.
#
#  In production (Render) you do NOT use a .env file — render.yaml wires
#  DATABASE_URL from the database, and the rest are set in the dashboard.
# ============================================================================

# REQUIRED. The only variable without a default.
#
# Render gives you two connection strings and they need different answers about
# TLS: the internal one is on the private network and its server does not offer
# TLS, so forcing it fails to connect; the external one requires it. Say which
# in the URL — pg reads sslmode, the same spelling libpq and psql use.
#
#   internal (what render.yaml wires in):  postgres://…@dpg-xxxx-a/hut
#   external (migrations from your machine): postgres://…render.com/hut?sslmode=require
DATABASE_URL=postgresql:///hut

# The first administrator, created on an empty database at first boot — and
# only then. This is how you get into a fresh deploy: `node staff.js add` needs
# a shell on the running service, and Render's Shell tab only exists on paid
# instance types.
#
# The password is never written to the log. Delete ADMIN_PASSWORD once you have
# logged in; the account stays and nothing re-reads the variable.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-something-long
ADMIN_NAME=Administrator

# How long a session lasts. A shift, not a fortnight: a hut terminal is a
# shared physical device, and a session that outlives the shift is one the next
# person inherits.
HUT_SESSION_HOURS=12

# The one exception: the resident self check-in tablet (role `kiosk`) is
# unattended and left running for days, so a 12-hour session would show the
# staff login on it twice a day. Defensible at thirty days specifically
# because that session can reach only two routes (search, record a check-in)
# and nothing else on the platform.
HUT_KIOSK_SESSION_DAYS=30

# LOCAL DEVELOPMENT ONLY. The session cookie is normally Secure and carries the
# __Host- prefix, which browsers refuse to store over plain http — so without
# this you can never log in at http://localhost. Never set it on Render, which
# terminates TLS.
# HUT_ALLOW_INSECURE_COOKIE=1

# Connection pool ceiling. The default (8) is sized for a handful of hut
# terminals and to stay well inside Render's limit on the smallest plans.
# PGPOOL_MAX=8

# ---------------------------------------------------------------------------
# Safeguarding alerts on a phone (Web Push)
# ---------------------------------------------------------------------------
# Generate one pair and keep it — changing them silently unsubscribes every
# device that already agreed:
#
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# Unset, the app says alerts are not configured instead of offering a button
# that does nothing.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
